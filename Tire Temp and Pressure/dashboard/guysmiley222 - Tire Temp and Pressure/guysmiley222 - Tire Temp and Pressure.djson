        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
          "IsTextItem": true,
          "Name": "LF temperature",
          "Text": "---",
          "Font": "Consolas",
          "FontSize": 24,
          "FontWeight": "Normal",
          "HorizontalAlignment": 0,
          "VerticalAlignment": 1,
          "BackgroundColor": "#00FFFFFF",
          "Left": 14,
          "Top": 75,
          "Width": 66,
          "Height": 32,
          "Visible": true,
          "Opacity": 100,
          "Bindings": {
            "Text": {
              "Formula": {
                "Expression": "if([DataCorePlugin.GameRunning] && [DataCorePlugin.CurrentGame] == 'IRacing',if(isnull([DataCorePlugin.GameRawData.Telemetry.LFtempCL],-1) >= 0 && isnull([DataCorePlugin.GameRawData.Telemetry.LFtempCM],-1) >= 0 && isnull([DataCorePlugin.GameRawData.Telemetry.LFtempCR],-1) >= 0 && (([DataCorePlugin.GameRawData.Telemetry.LFtempCL] + [DataCorePlugin.GameRawData.Telemetry.LFtempCM] + [DataCorePlugin.GameRawData.Telemetry.LFtempCR]) / 3.0) <= 999,format(([DataCorePlugin.GameRawData.Telemetry.LFtempCL] + [DataCorePlugin.GameRawData.Telemetry.LFtempCM] + [DataCorePlugin.GameRawData.Telemetry.LFtempCR]) / 3.0,'000'),'---'),'---')"
              },
              "Mode": 2,
              "TargetPropertyName": "Text"
            },
            "TextColor": {
              "Formula": {
                "Expression": "if(isnull([Settings.Theme.Key],'current') == 'vscode-dark','#FFD4D4D4',if(isnull([Settings.Theme.Key],'current') == 'dracula','#FFF8F8F2',if(isnull([Settings.Theme.Key],'current') == 'nord','#FFECEFF4',if(isnull([Settings.Theme.Key],'current') == 'monokai','#FFF8F8F2',if(isnull([Settings.Theme.Key],'current') == 'solarized-dark','#FF93A1A1','#FFFFFFFF')))))"
              },
              "Mode": 2,
              "TargetPropertyName": "TextColor"
            }
          },
          "TextColor": "#FFFFFFFF"
        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
          "IsTextItem": true,
          "Name": "LF temperature label",
