              "Formula": {
                "Expression": "if([DataCorePlugin.GameRunning] && [DataCorePlugin.CurrentGame] == 'IRacing',if(isnull([DataCorePlugin.GameRawData.Telemetry.LFcoldPressure],-1) >= 0 && ([DataCorePlugin.GameRawData.Telemetry.LFcoldPressure] / 6.894757293168) <= 99.9 && [DataCorePlugin.GameRawData.Telemetry.LFcoldPressure] > 0,format([DataCorePlugin.GameRawData.Telemetry.LFcoldPressure] / 6.894757293168,'00.0'),'---'),'---')"
